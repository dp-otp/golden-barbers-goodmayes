{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".validate": "newData.isBoolean()"
      }
    },

    "announcement": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "announceHistory": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "shopStatus": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "siteTheme": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "siteDiscount": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "discounts": {
      ".read": true,
      ".indexOn": ["active", "code"],
      "$discountId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "usedCount": {
          ".write": true,
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
        }
      }
    },

    "servicePrices": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "settings": {
      "activeBank":      { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
      "businessProfile": { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
      "hours":           { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" }
    },

    "staff": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["onDuty", "name"]
    },

    "liveGallery": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "promotions": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "hiddenGalleryPhotos": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "photoReplacements": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "bookings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["createdAt", "date", "reference"],
      "$bookingId": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['reference','createdAt','status']) && newData.child('reference').isString() && newData.child('reference').val().length <= 32 && newData.child('createdAt').isString() && newData.child('status').isString()",
        "customerName":  { ".validate": "newData.isString() && newData.val().length <= 80" },
        "customerPhone": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "customerEmail": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "service":       { ".validate": "newData.isString() && newData.val().length <= 80" },
        "date":          { ".validate": "newData.isString() && newData.val().length <= 16" },
        "time":          { ".validate": "newData.isString() && newData.val().length <= 16" },
        "barber":        { ".validate": "newData.isString() && newData.val().length <= 64" },
        "price":         { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "$other":        { ".validate": true }
      }
    },

    "payments": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["status", "createdAt", "date"],
      "$paymentId": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['amount','status','createdAt']) && newData.child('amount').isNumber() && newData.child('amount').val() >= 0 && newData.child('amount').val() <= 10000 && newData.child('status').isString() && (!data.exists() ? newData.child('status').val() === 'pending' : true) && newData.child('createdAt').isString()",
        "customerName":  { ".validate": "newData.isString() && newData.val().length <= 80" },
        "customerPhone": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "items":         { ".validate": "newData.hasChildren() || newData.val() === null" },
        "$other":        { ".validate": true }
      }
    },

    "visits": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["createdAt", "date", "paymentStatus", "visitStatus"],
      "$visitId": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['createdAt']) && newData.child('createdAt').isString()",
        "$other":        { ".validate": true }
      }
    },

    "revenue": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["date"]
    },

    "goals": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "activityLog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["timestamp"]
    },

    "opsNotifications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false,
      ".indexOn": ["createdAt"]
    },

    "autoManager": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "reviews": {
        "queue":   { ".indexOn": ["queuedAt", "status"] },
        "settings": {}
      },
      "inventory": {
        "products":  { ".indexOn": ["name", "category"] },
        "stockLog":  { ".indexOn": ["timestamp"] }
      },
      "expenses": {
        "recurring": { ".indexOn": ["active", "category"] },
        "oneoff":    { ".indexOn": ["date"] },
        "generated": {}
      },
      "clients": {},
      "commissions": {
        "assignments": { ".indexOn": ["date", "staffKey"] },
        "settings": {}
      },
      "meta": {}
    },

    "automationV2": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "commands":   { ".indexOn": ["createdAt", "type", "status"] },
      "summaries":  { "daily": { ".indexOn": ["date"] } },
      "integrations": {
        "whatsapp": {
          "inbound":      { ".indexOn": ["timestamp", "from"] },
          "statusEvents": { ".indexOn": ["timestamp"] },
          "webhooks":     {}
        },
        "revolut": { "webhooks": {} }
      }
    }
  }
}
